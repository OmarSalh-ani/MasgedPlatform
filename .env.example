# Apex domain (no protocol). DNS A records required for:
#   @ (customer.com), admin.customer.com, api.customer.com
DOMAIN=customer.com

# Let's Encrypt contact email
ACME_EMAIL=admin@customer.com

# Prebuilt images (ignored when building from source with docker-compose.build.yml)
IMAGE_REGISTRY=ghcr.io/your-github-org
IMAGE_TAG=latest

# SQL Server Express SA password (must meet complexity rules)
MSSQL_SA_PASSWORD=ChangeMe_StrongPass123!

# JWT secrets (min 32 characters each)
JWT_KEY=AdminAPI_ChangeThisSecretKey_Min32Chars!
MOBILE_JWT_KEY=MobileAPI_ChangeThisSecretKey_Min32Chars!
TEACHER_JWT_KEY=TeacherAPI_ChangeThisSecretKey_Min32Chars!
STUDENT_QR_KEY=StudentQr_ChangeThisSecretKey_Min32Chars!
CHAT_INTERNAL_KEY=ChatInternal_ChangeThisKey_Min32Chars!

# Wasender (WhatsApp) — also editable later in Admin → Integrations
WASENDER_API_TOKEN=
WASENDER_SESSION_API_KEY=

# Agora (video calls) — also editable later in Admin → Integrations
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Firebase push notifications.
# Set to true only after copying firebase-service-account.json into ./secrets/
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=

# Optional store links shown on the public website
APP_STORE_URL=
GOOGLE_PLAY_URL=
MOBILE_APP_BANNER_IMAGE=
